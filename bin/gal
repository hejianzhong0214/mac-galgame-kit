#!/bin/bash
# gal — 在 Apple Silicon Mac 上运行 galgame / 小游戏的辅助脚本
# 兼容 macOS 自带的 bash 3.2
set -euo pipefail

GAL_HOME="${GAL_HOME:-$HOME/Games/gal}"
BOTTLES="$GAL_HOME/bottles"
RUNTIMES="$GAL_HOME/runtimes"
DEFAULT_BOTTLE="${GAL_BOTTLE:-default}"
# 关掉 MoltenVK 每次启动刷屏的设备信息
export MVK_CONFIG_LOG_LEVEL="${MVK_CONFIG_LOG_LEVEL:-0}"

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WINE_URL="https://github.com/Gcenx/macOS_Wine_builds/releases"

# 可以并存多个 Wine：Wine Stable / Wine Devel / Wine Staging（Gcenx 构建的 .app 名）
WINE_APPS="Wine Stable|Wine Devel|Wine Staging"

# 输出某个 Wine 的 bin 目录；没装返回 1
wine_bin_of() {
  local d
  for d in "$RUNTIMES/$1.app/Contents/Resources/wine/bin" "/Applications/$1.app/Contents/Resources/wine/bin"; do
    if [ -x "$d/wine" ]; then echo "$d"; return 0; fi
  done
  return 1
}

use_wine() {
  local b
  b="$(wine_bin_of "$1")" || die "没有安装 $1，用 gal setup --wine-tarball <包> 安装"
  PATH="$b:$PATH"
  export PATH
}

# 默认 Wine：GAL_WINE_DIR，其次稳定版，再其次开发版、staging
locate_wine() {
  if [ -n "${GAL_WINE_DIR:-}" ] && [ -x "$GAL_WINE_DIR/wine" ]; then
    PATH="$GAL_WINE_DIR:$PATH"; export PATH; return 0
  fi
  local a b
  local IFS='|'
  for a in $WINE_APPS; do
    if b="$(wine_bin_of "$a")"; then PATH="$b:$PATH"; export PATH; return 0; fi
  done
  return 0
}
locate_wine

# 容器可以指定自己的 Wine（记在 <容器>/.gal-wine），用 gal wine 设置
select_bottle_wine() {
  local f="$BOTTLES/$1/.gal-wine"
  if [ -f "$f" ]; then use_wine "$(cat "$f")"; fi
}

need_wine() {
  have wine || die "没有找到 wine，请先运行: gal setup"
}

# 从本地 tar.xz 安装 Wine 到 $RUNTIMES，不需要联网和管理员权限；保留包里的 .app 名
install_wine_tarball() {
  local tb="$1"
  [ -f "$tb" ] || die "找不到文件: $tb"
  local tmp
  tmp="$(mktemp -d)"
  say "解压 $tb"
  tar -xJf "$tb" -C "$tmp"
  local app name
  app="$(find "$tmp" -maxdepth 2 -name 'Wine*.app' -print -quit)"
  [ -n "$app" ] || die "压缩包里没有找到 Wine*.app"
  name="$(basename "$app")"
  mkdir -p "$RUNTIMES"
  if [ -d "$RUNTIMES/$name" ]; then rm -r "$RUNTIMES/$name"; fi
  mv "$app" "$RUNTIMES/$name"
  rm -rf "$tmp"
  xattr -dr com.apple.quarantine "$RUNTIMES/$name" 2>/dev/null || true
  locate_wine
  have wine || die "安装后仍然找不到 wine"
  say "已安装 $name（$("$RUNTIMES/$name/Contents/Resources/wine/bin/wine" --version 2>/dev/null)）"
}

has_rosetta() {
  arch -x86_64 /usr/bin/true >/dev/null 2>&1
}

locale_of() {
  case "$1" in
    ja)   echo "ja_JP.UTF-8" ;;
    zh)   echo "zh_CN.UTF-8" ;;
    tw)   echo "zh_TW.UTF-8" ;;
    ko)   echo "ko_KR.UTF-8" ;;
    none) echo "" ;;
    *)    die "未知语言: $1（可选 ja / zh / tw / ko / none）" ;;
  esac
}

usage() {
  cat <<'EOF'
用法: gal <命令> [参数]

  import [-l 语言] [-n 名字] [--start] <exe | 游戏文件夹 | zip>
                              一键导入：识别引擎、建隔离容器、拷贝游戏、Unity 自动装 DXVK、生成启动器
  list                        列出导入的游戏
  remove <名字>               删除导入的游戏（只删容器里的副本，原始文件不动）
  doctor                      检查环境
  setup [--wine-tarball 文件]  安装 Rosetta 2 和 Wine，并创建默认容器（可用本地包离线安装）
  detect <游戏目录>           识别游戏引擎并给出推荐路线
  run [-b 容器] [-l 语言] <exe> [参数...]
                              用 Wine 启动；语言: ja(默认) zh tw ko none
  nw <游戏目录>               用原生 arm64 NW.js 启动 RPG Maker MV/MZ、TyranoScript 游戏
  nw-install                  下载/更新 NW.js（NWJS_VERSION=v0.xx.x 可指定版本）
  bottle <名字>               新建或修复一个 Wine 容器
  cfg [-b 容器]               打开 winecfg
  kill [-b 容器]              结束容器内所有进程
  wine [-b 容器] [stable|devel|staging]
                              查看或切换容器用的 Wine 版本（Unity 6 鼠标失灵要用 devel）
  launcher <名字> [-b 容器] [-l 语言] <exe> [参数...]
                              生成可双击的启动器（~/Games/gal/launch/<名字>.command）
  start <名字>                在桌面会话里运行启动器（从 SSH 远程启动游戏用这个）
  dxvk [-b 容器] <tar.gz>     把 DXVK-macOS 装进容器（Unity 等 D3D11 游戏图形初始化失败时用）

环境变量:
  GAL_HOME    数据目录，默认 ~/Games/gal
  GAL_BOTTLE  默认容器名，默认 default
  NWJS_APP    自定义 nwjs.app 路径
EOF
}

cmd_doctor() {
  [ "$(uname -s)" = "Darwin" ] || die "这个脚本只支持 macOS"

  if [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = "1" ]; then
    say "芯片: Apple Silicon ($(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo unknown))"
  else
    warn "芯片: 不是 Apple Silicon，本方案的原生路线不适用"
  fi
  say "系统: macOS $(sw_vers -productVersion)"
  say "内存: $(( $(sysctl -n hw.memsize) / 1073741824 )) GB"

  if has_rosetta; then say "Rosetta 2: 已安装"; else warn "Rosetta 2: 未安装（gal setup 会安装）"; fi

  local t
  for t in brew wine; do
    if have "$t"; then say "$t: $(command -v "$t")"; else warn "$t: 未安装"; fi
  done
  if have wine; then say "默认 wine 版本: $(wine --version 2>/dev/null || echo 无法获取)"; fi
  local a b
  local IFS='|'
  for a in $WINE_APPS; do
    if b="$(wine_bin_of "$a")"; then say "已安装 $a: $("$b/wine" --version 2>/dev/null)"; fi
  done
  unset IFS

  if [ -d "/Applications/CrossOver.app" ]; then say "CrossOver: 已安装（3D 游戏优先用它）"; fi

  if pmset -g 2>/dev/null | grep -Eq 'lowpowermode[[:space:]]+1'; then
    warn "低电量模式已开启，性能会被限制"
  else
    say "低电量模式: 关闭"
  fi

  say "可用空间: $(df -h "$HOME" | awk 'NR==2 {print $4}')"
  if [ -d "$BOTTLES" ]; then
    say "容器: $(ls "$BOTTLES" 2>/dev/null | tr '\n' ' ')"
  else
    warn "还没有容器（gal setup 会创建）"
  fi
}

cmd_setup() {
  [ "$(uname -s)" = "Darwin" ] || die "这个脚本只支持 macOS"
  have brew || die "请先安装 Homebrew: https://brew.sh"

  if ! has_rosetta; then
    say "安装 Rosetta 2"
    softwareupdate --install-rosetta --agree-to-license
  fi

  mkdir -p "$BOTTLES" "$RUNTIMES"

  if [ "${1:-}" = "--wine-tarball" ]; then
    [ $# -ge 2 ] || die "--wine-tarball 后面要跟文件路径"
    install_wine_tarball "$2"
  fi

  if ! have wine; then
    say "安装 Wine"
    if ! brew install --cask wine-stable; then
      warn "Homebrew 安装 Wine 失败（多半是连不上 GitHub）"
      warn "请在能访问 GitHub 的机器上从 $WINE_URL 下载 wine-stable-*-osx64.tar.xz，"
      warn "拷到本机后执行: gal setup --wine-tarball <文件路径>"
      exit 1
    fi
    locate_wine
  fi
  if [ -d "/Applications/Wine Stable.app" ]; then
    xattr -dr com.apple.quarantine "/Applications/Wine Stable.app" 2>/dev/null || true
  fi

  if [ ! -d "/Library/Frameworks/GStreamer.framework" ]; then
    warn "没有 GStreamer 运行库，游戏内视频可能无法播放。需要时手动执行（要输入管理员密码）:"
    warn "  brew install --cask gstreamer-runtime"
  fi
  if [ ! -d "$BOTTLES/$DEFAULT_BOTTLE" ]; then
    cmd_bottle "$DEFAULT_BOTTLE"
  fi

  say "完成。试试: gal run /path/to/game.exe"
}

cmd_bottle() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: gal bottle <名字>"
  need_wine

  local p="$BOTTLES/$name"
  mkdir -p "$BOTTLES"
  say "初始化容器: $p"

  export WINEPREFIX="$p"
  export WINEDEBUG=-all
  wineboot -u

  # 导入默认设置：关闭 Retina 模式、字体抗锯齿、
  # 把 Windows 的中日韩字体名映射到 macOS 自带字体（不用下载任何字体）
  local reg_src="$SCRIPT_DIR/../share/gal-defaults.reg"
  [ -f "$reg_src" ] || die "找不到 $reg_src"
  local tmp
  tmp="$(mktemp -d)"
  # regedit 要求 UTF-16LE + BOM + CRLF
  {
    printf '\377\376'
    awk '{ printf "%s\r\n", $0 }' "$reg_src" | iconv -f UTF-8 -t UTF-16LE
  } > "$tmp/gal.reg"
  ( cd "$tmp" && wine regedit /S gal.reg ) || warn "导入默认设置失败"
  rm -rf "$tmp"

  wineserver -w || true
  say "容器 $name 就绪"
}

# 解析 -b / -l 选项；结果写入全局 OPT_BOTTLE、OPT_LANG、OPT_SHIFT
parse_opts() {
  OPT_BOTTLE="$DEFAULT_BOTTLE"
  OPT_LANG="ja"
  OPT_SHIFT=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -b) [ $# -ge 2 ] || die "-b 后面要跟容器名"; OPT_BOTTLE="$2"; shift 2; OPT_SHIFT=$((OPT_SHIFT + 2)) ;;
      -l) [ $# -ge 2 ] || die "-l 后面要跟语言"; OPT_LANG="$2"; shift 2; OPT_SHIFT=$((OPT_SHIFT + 2)) ;;
      --) OPT_SHIFT=$((OPT_SHIFT + 1)); break ;;
      -*) die "未知选项: $1" ;;
      *)  break ;;
    esac
  done
}

cmd_run() {
  parse_opts "$@"
  shift "$OPT_SHIFT"
  [ $# -ge 1 ] || die "用法: gal run [-b 容器] [-l 语言] <exe> [参数...]"

  local exe="$1"
  shift
  [ -f "$exe" ] || die "找不到文件: $exe"
  select_bottle_wine "$OPT_BOTTLE"
  need_wine

  local loc
  loc="$(locale_of "$OPT_LANG")"

  local p="$BOTTLES/$OPT_BOTTLE"
  if [ ! -d "$p" ]; then
    warn "容器 $OPT_BOTTLE 不存在，先创建"
    cmd_bottle "$OPT_BOTTLE"
  fi
  # Wine 升级时会重建 Z: 盘和指向主目录的链接，每次启动前重新断开
  if [ -f "$p/.gal-isolated" ]; then isolate_bottle "$p"; fi

  local dir base
  dir="$(cd "$(dirname "$exe")" && pwd)"
  base="$(basename "$exe")"

  # 很多游戏用相对路径找资源，必须在游戏目录里启动
  cd "$dir"

  export WINEPREFIX="$p"
  export WINEDEBUG="${WINEDEBUG:--all}"
  export WINEMSYNC=1
  export WINEESYNC=1
  if [ -n "$loc" ]; then
    export LC_ALL="$loc"
    export LANG="$loc"
  fi

  say "容器: $OPT_BOTTLE  $(wine --version 2>/dev/null)  区域: ${loc:-系统默认}  程序: $base"
  exec wine "$base" "$@"
}

cmd_cfg() {
  parse_opts "$@"
  select_bottle_wine "$OPT_BOTTLE"
  need_wine
  WINEPREFIX="$BOTTLES/$OPT_BOTTLE" WINEDEBUG=-all exec winecfg
}

# 把 DXVK-macOS 装进容器：D3D10/11 → Vulkan → MoltenVK → Metal
# 用于 Wine 自带 D3D11 初始化失败的 Unity 等游戏
cmd_dxvk() {
  parse_opts "$@"
  shift "$OPT_SHIFT"
  local tb="${1:-}"
  [ -n "$tb" ] && [ -f "$tb" ] || die "用法: gal dxvk [-b 容器] <dxvk-macOS-*.tar.gz>（下载: https://github.com/Gcenx/DXVK-macOS/releases）"
  select_bottle_wine "$OPT_BOTTLE"
  need_wine

  local p="$BOTTLES/$OPT_BOTTLE"
  [ -d "$p" ] || die "容器 $OPT_BOTTLE 不存在"

  local tmp
  tmp="$(mktemp -d)"
  tar -xzf "$tb" -C "$tmp"
  local x64 x32
  x64="$(find "$tmp" -type d -name x64 -print -quit)"
  x32="$(find "$tmp" -type d -name x32 -print -quit)"
  [ -n "$x64" ] && [ -f "$x64/d3d11.dll" ] || { rm -rf "$tmp"; die "压缩包里没有 x64/d3d11.dll，请用不带 -builtin 的版本"; }

  cp "$x64"/*.dll "$p/drive_c/windows/system32/"
  if [ -n "$x32" ] && [ -d "$p/drive_c/windows/syswow64" ]; then
    cp "$x32"/*.dll "$p/drive_c/windows/syswow64/"
  fi
  rm -rf "$tmp"

  local d
  for d in d3d11 d3d10core; do
    ( cd "$p/drive_c" && WINEPREFIX="$p" WINEDEBUG=-all \
      wine reg add 'HKCU\Software\Wine\DllOverrides' /v "$d" /t REG_SZ /d native /f >/dev/null )
  done
  WINEPREFIX="$p" wineserver -w || true
  say "DXVK 已装进容器 $OPT_BOTTLE（只影响这个容器）"
}

# 生成可双击的启动器 ~/Games/gal/launch/<名字>.command
# 游戏必须在桌面会话里启动；从 SSH 直接 gal run 会报 “no driver could be loaded”
cmd_launcher() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: gal launcher <名字> [-b 容器] [-l 语言] <exe> [参数...]"
  shift
  parse_opts "$@"
  shift "$OPT_SHIFT"
  [ $# -ge 1 ] || die "用法: gal launcher <名字> [-b 容器] [-l 语言] <exe> [参数...]"
  [ -f "$1" ] || die "找不到文件: $1"

  local exe
  exe="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
  shift

  write_launcher "$name" run -b "$OPT_BOTTLE" -l "$OPT_LANG" "$exe" "$@"
  say "双击它启动，或在终端/SSH 里执行: gal start $name"
}

# 写 ~/Games/gal/launch/<名字>.command，内容是 exec gal <参数...>
write_launcher() {
  local name="$1"
  shift
  local self
  self="$SCRIPT_DIR/$(basename "$0")"
  mkdir -p "$GAL_HOME/launch" "$GAL_HOME/logs"
  local f="$GAL_HOME/launch/$name.command"
  {
    echo '#!/bin/bash'
    echo "# 由 gal 生成，可双击运行；日志在 $GAL_HOME/logs/$name.log"
    printf 'exec %q' "$self"
    local a
    for a in "$@"; do printf ' %q' "$a"; done
    printf ' > %q 2>&1\n' "$GAL_HOME/logs/$name.log"
  } > "$f"
  chmod +x "$f"
  say "已生成启动器 $f"
}

cmd_start() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: gal start <名字>"
  local f="$GAL_HOME/launch/$name.command"
  [ -x "$f" ] || die "没有启动器 $f，先用 gal launcher 生成"
  open "$f"
  say "已在桌面会话里启动 $name，日志: $GAL_HOME/logs/$name.log"
}

cmd_kill() {
  parse_opts "$@"
  select_bottle_wine "$OPT_BOTTLE"
  need_wine
  WINEPREFIX="$BOTTLES/$OPT_BOTTLE" wineserver -k || true
  say "已结束容器 $OPT_BOTTLE 里的进程"
}

# 查看或切换容器使用的 Wine：gal wine [-b 容器] [stable|devel|staging]
cmd_wine() {
  parse_opts "$@"
  shift "$OPT_SHIFT"
  local p="$BOTTLES/$OPT_BOTTLE"
  [ -d "$p" ] || die "容器 $OPT_BOTTLE 不存在"

  local a b cur="默认"
  if [ -f "$p/.gal-wine" ]; then cur="$(cat "$p/.gal-wine")"; fi
  if [ $# -eq 0 ]; then
    say "容器 $OPT_BOTTLE 当前用: $cur"
    local IFS='|'
    for a in $WINE_APPS; do
      if b="$(wine_bin_of "$a")"; then say "  已安装 $a: $("$b/wine" --version 2>/dev/null)"; fi
    done
    return 0
  fi

  local app
  case "$1" in
    stable) app="Wine Stable" ;;
    devel) app="Wine Devel" ;;
    staging) app="Wine Staging" ;;
    *) die "可选 stable / devel / staging" ;;
  esac
  wine_bin_of "$app" >/dev/null || die "没有安装 $app，用 gal setup --wine-tarball <包> 安装"

  # 先用旧版本结束容器里的进程，版本不同的 wineserver 互相管不了
  ( select_bottle_wine "$OPT_BOTTLE"; WINEPREFIX="$p" wineserver -k 2>/dev/null || true )
  echo "$app" > "$p/.gal-wine"
  use_wine "$app"
  say "升级容器到 $(wine --version)"
  ( cd "$p/drive_c" && WINEPREFIX="$p" WINEDEBUG=-all wineboot -u )
  WINEPREFIX="$p" wineserver -w || true
  if [ -f "$p/.gal-isolated" ]; then isolate_bottle "$p"; fi
  say "容器 $OPT_BOTTLE 改用 $app"
}

cmd_nw_install() {
  have curl || die "需要 curl"
  local ver="${NWJS_VERSION:-}"
  if [ -z "$ver" ]; then
    ver="$(curl -fsSL https://nwjs.io/versions.json | grep -m1 '"latest"' | sed -E 's/.*"(v[0-9.]+)".*/\1/')"
  fi
  case "$ver" in
    v[0-9]*) ;;
    *) die "无法确定 NW.js 版本，请用 NWJS_VERSION=v0.xx.x 指定" ;;
  esac

  local url="https://dl.nwjs.io/$ver/nwjs-$ver-osx-arm64.zip"
  local tmp
  tmp="$(mktemp -d)"
  say "下载 NW.js $ver (arm64)"
  curl -fL --progress-bar -o "$tmp/nwjs.zip" "$url" || die "下载失败: $url"
  ditto -x -k "$tmp/nwjs.zip" "$tmp/out"

  local found
  found="$(find "$tmp/out" -maxdepth 2 -name 'nwjs.app' -print -quit)"
  [ -n "$found" ] || die "压缩包里没有找到 nwjs.app"

  mkdir -p "$RUNTIMES"
  rm -rf "$RUNTIMES/nwjs.app"
  mv "$found" "$RUNTIMES/nwjs.app"
  rm -rf "$tmp"
  xattr -dr com.apple.quarantine "$RUNTIMES/nwjs.app" 2>/dev/null || true
  say "NW.js 已安装到 $RUNTIMES/nwjs.app"
}

cmd_nw() {
  local d="${1:-}"
  [ -n "$d" ] && [ -d "$d" ] || die "用法: gal nw <游戏目录>"
  d="$(cd "$d" && pwd)"

  [ -f "$d/package.json" ] || die "$d 里没有 package.json，这不是 NW.js 游戏，或者需要先补一个（见 docs/engines.md）"

  if grep -Eq '"name"[[:space:]]*:[[:space:]]*""' "$d/package.json"; then
    die "package.json 里的 \"name\" 是空的，NW.js 会拒绝启动。请把它改成任意非空值，例如 \"name\": \"game\""
  fi

  local app="${NWJS_APP:-$RUNTIMES/nwjs.app}"
  if [ ! -d "$app" ]; then
    cmd_nw_install
  fi

  say "用原生 NW.js 启动: $d"
  exec "$app/Contents/MacOS/nwjs" "$d"
}

# 识别引擎，输出一个关键字
detect_engine() {
  local d="$1"
  _has() { [ -n "$(find "$d" -maxdepth 3 -iname "$1" -print -quit 2>/dev/null)" ]; }

  if   _has '*.rpa' || _has '*.rpyc' || _has 'renpy'; then echo renpy
  elif _has '*.app'; then echo macapp
  elif _has 'rmmz_core.js'; then echo mz
  elif _has 'rpg_core.js'; then echo mv
  elif _has '*.rgss3a'; then echo rgss3
  elif _has '*.rgss2a'; then echo rgss2
  elif _has '*.rgssad'; then echo rgss1
  elif _has 'tyrano'; then echo tyrano
  elif _has 'nscript.dat' || _has 'arc.nsa' || _has 'nscript.___'; then echo nscripter
  elif _has '*.xp3'; then echo kirikiri
  elif _has 'Scene.pck' || _has 'Gameexe.dat' || _has 'SiglusEngine*.exe'; then echo siglus
  elif _has 'Seen.txt' || _has 'RealLive.exe'; then echo reallive
  elif _has 'UnityPlayer.dll' || _has 'globalgamemanagers' || _has '*_Data'; then echo unity
  elif _has 'cs2.exe' || _has '*.int'; then echo catsystem2
  elif _has 'BGI.exe' || _has 'BHVC.exe'; then echo bgi
  elif _has '*.wolf'; then echo wolf
  elif _has 'nw.dll' || _has 'package.nw' || _has 'package.json'; then echo nwjs
  elif _has '*.exe'; then echo exe
  else echo unknown
  fi
}

engine_title() {
  case "$1" in
    renpy) echo "Ren'Py" ;;
    macapp) echo "自带 macOS 版" ;;
    mz) echo "RPG Maker MZ" ;;
    mv) echo "RPG Maker MV" ;;
    rgss3) echo "RPG Maker VX Ace" ;;
    rgss2) echo "RPG Maker VX" ;;
    rgss1) echo "RPG Maker XP" ;;
    tyrano) echo "TyranoScript" ;;
    nscripter) echo "NScripter" ;;
    kirikiri) echo "吉里吉里" ;;
    siglus) echo "SiglusEngine" ;;
    reallive) echo "RealLive" ;;
    unity) echo "Unity" ;;
    catsystem2) echo "CatSystem2" ;;
    bgi) echo "BGI / Ethornell" ;;
    wolf) echo "Wolf RPG Editor" ;;
    nwjs) echo "NW.js 网页游戏" ;;
    exe) echo "未识别的 Windows 游戏" ;;
    *) echo "未知" ;;
  esac
}

cmd_detect() {
  local d="${1:-.}"
  [ -d "$d" ] || die "用法: gal detect <游戏目录>"

  local e
  e="$(detect_engine "$d")"
  report() {
    say "引擎: $(engine_title "$e")"
    say "路线: $1"
    if [ -n "${2:-}" ]; then say "做法: $2"; fi
  }

  case "$e" in
    renpy)
      if [ -n "$(find "$d" -maxdepth 3 -iname '*.app' -print -quit)" ]; then
        report "原生" "直接打开目录里的 .app"
      else
        report "原生 Ren'Py SDK，或 Wine" "见 docs/engines.md；省事就 gal import"
      fi ;;
    macapp) report "原生" "直接打开 .app；用 file 命令确认里面是 arm64 还是 x86_64" ;;
    mz|mv) report "原生 NW.js" "gal import \"$d\"（或 gal nw \"$d\"）" ;;
    rgss1|rgss2|rgss3) report "原生 mkxp-z，或 Wine" "见 docs/engines.md；省事就 gal import" ;;
    tyrano|nwjs) report "原生 NW.js，不行再 Wine" "gal import \"$d\"" ;;
    nscripter) report "原生 ONScripter，或 Wine" "见 docs/engines.md；省事就 gal import" ;;
    unity) report "Wine + DXVK" "gal import \"$d\"（会自动装 DXVK）" ;;
    kirikiri|siglus|reallive|catsystem2|bgi|wolf) report "Wine，日文区域" "gal import \"$d\"" ;;
    exe) report "Wine" "gal import \"$d\"；日文游戏保持默认区域，其他加 -l none" ;;
    *) warn "没有识别出引擎，目录里也没有 exe"; return 1 ;;
  esac
}

# 在 root 下找主程序 exe；包里有多个游戏时返回 2 并列出
pick_exe() {
  local root="$1"
  local cands
  cands="$(find "$root" -maxdepth 6 -type f -iname '*.exe' \
             -not -path '*/MonoBleedingEdge/*' -not -path '*/_CommonRedist/*' \
             -not -path '*/[Rr]edist/*' -not -path '*/__MACOSX/*' 2>/dev/null \
           | grep -viE '/[^/]*(crashhandler|unins|setup|install|redist|dxweb|activate|crashpad|updater|update|notification_helper|config|启动器|激活)[^/]*\.exe$' \
           || true)"
  [ -n "$cands" ] || return 1

  # 最浅的候选所在目录就是游戏目录
  local first gdir
  first="$(printf '%s\n' "$cands" | awk -F/ '{ print NF "\t" $0 }' | sort -n | head -1 | cut -f2-)"
  gdir="$(dirname "$first")"

  # 其他候选不在这个目录下 → 包里不止一个游戏
  local other
  # 注意：bash 3.2 不能在 $(...) 里写 case，用前缀比较代替
  other="$(printf '%s\n' "$cands" | while IFS= read -r c; do
             if [ "${c#"$gdir"/}" = "$c" ]; then dirname "$c"; fi
           done | sort -u)"
  if [ -n "$other" ]; then
    warn "包里有多个游戏，请先解压，再把单个游戏的文件夹拖进来:"
    { echo "$gdir"; printf '%s\n' "$other"; } | sort -u | sed "s|^$root/||; s|^|    |" >&2
    return 2
  fi

  # 同一目录里：Unity 选有同名 _Data 的那个，否则选最大的
  local c best="" bestsize=-1 s
  while IFS= read -r c; do
    [ "$(dirname "$c")" = "$gdir" ] || continue
    if [ -d "${c%.*}_Data" ]; then best="$c"; break; fi
    s="$(stat -f %z "$c")"
    if [ "$s" -gt "$bestsize" ]; then best="$c"; bestsize="$s"; fi
  done <<EOF
$cands
EOF
  echo "$best"
}

# 解压 zip；Windows 上打的包文件名多是 GBK / Shift-JIS，用 python 正确解码
extract_zip() {
  local zip="$1" out="$2"
  mkdir -p "$out"
  if /usr/bin/python3 -c 1 >/dev/null 2>&1; then
    /usr/bin/python3 -I - "$zip" "$out" <<'PY'
import os, shutil, sys, zipfile
zpath, out = sys.argv[1], os.path.realpath(sys.argv[2])
z = zipfile.ZipFile(zpath)
names = [i.filename for i in z.infolist() if not i.flag_bits & 0x800]
enc = None
for cand in ("gbk", "shift_jis", "cp437"):
    try:
        for n in names: n.encode("cp437").decode(cand)
        enc = cand; break
    except Exception:
        pass
for i in z.infolist():
    n = i.filename
    if not i.flag_bits & 0x800 and enc and enc != "cp437":
        n = n.encode("cp437").decode(enc)
    dst = os.path.realpath(os.path.join(out, n))
    if not dst.startswith(out + os.sep):
        continue  # 拒绝 ../ 之类的路径
    if n.endswith("/"):
        os.makedirs(dst, exist_ok=True); continue
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with z.open(i) as s, open(dst, "wb") as d:
        shutil.copyfileobj(s, d)
PY
  else
    ditto -x -k "$zip" "$out"
  fi
}

# 断开容器和 Mac 主目录的映射：去掉 Z: 盘，“文档/桌面”等改成容器内的普通文件夹
isolate_bottle() {
  local p="$1"
  rm -f "$p/dosdevices/z:"
  local u="$p/drive_c/users/$USER" d
  for d in Desktop Documents Downloads Music Pictures Videos; do
    if [ -L "$u/$d" ]; then rm "$u/$d"; mkdir -p "$u/$d"; fi
  done
}

safe_name() {
  local n
  n="$(printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-' | sed -E 's/-+/-/g; s/^[-.]+//; s/-+$//')"
  case "$n" in ""|-) n="game-$(date +%Y%m%d-%H%M%S)" ;; esac
  local base="$n" i=2
  while [ -e "$BOTTLES/$n" ] || [ -e "$GAL_HOME/games/$n" ] || [ -e "$GAL_HOME/launch/$n.meta" ]; do
    n="$base-$i"; i=$((i + 1))
  done
  echo "$n"
}

find_dxvk() {
  find "$GAL_HOME/downloads" -maxdepth 1 -name 'dxvk-macOS-*.tar.gz' -not -name '*builtin*' 2>/dev/null | sort | tail -1
}

# 一键导入：exe / 游戏文件夹 / zip → 隔离容器 + 启动器
cmd_import() {
  local lang="ja" name="" start=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -l) [ $# -ge 2 ] || die "-l 后面要跟语言"; lang="$2"; shift 2 ;;
      -n) [ $# -ge 2 ] || die "-n 后面要跟名字"; name="$2"; shift 2 ;;
      --start) start=1; shift ;;
      -*) die "未知选项: $1" ;;
      *) break ;;
    esac
  done
  [ $# -eq 1 ] || die "用法: gal import [-l 语言] [-n 名字] [--start] <exe | 游戏文件夹 | zip>"
  locale_of "$lang" >/dev/null

  local src="$1"
  [ -e "$src" ] || die "找不到: $src"
  src="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"

  mkdir -p "$GAL_HOME/tmp" "$GAL_HOME/launch" "$GAL_HOME/logs"
  IMPORT_STAGE=""
  local root exe=""
  case "$src" in
    *.zip|*.ZIP)
      IMPORT_STAGE="$(mktemp -d "$GAL_HOME/tmp/import.XXXXXX")"
      say "解压 $(basename "$src")"
      extract_zip "$src" "$IMPORT_STAGE/x"
      root="$IMPORT_STAGE/x" ;;
    *.exe|*.EXE)
      exe="$src"; root="$(dirname "$src")" ;;
    *)
      [ -d "$src" ] || die "只支持 exe、文件夹或 zip: $src"
      root="$src" ;;
  esac
  # 出错时清理解压的临时目录
  trap 'if [ -n "${IMPORT_STAGE:-}" ]; then rm -rf "$IMPORT_STAGE"; fi' EXIT

  if [ -z "$exe" ]; then
    local rc=0
    exe="$(pick_exe "$root")" || rc=$?
    [ "$rc" -ne 2 ] || exit 1
    [ -n "$exe" ] || die "没有找到游戏的 exe"
  fi
  local gdir
  gdir="$(dirname "$exe")"
  case "$gdir" in
    "$HOME"|"$HOME/Desktop"|"$HOME/Downloads"|"$HOME/Documents"|/|/Applications)
      die "游戏要放在单独的文件夹里（现在在 $gdir），整个文件夹会被拷进容器" ;;
  esac

  local title rel engine
  title="$(basename "$gdir")"
  rel="${exe#"$gdir"/}"
  engine="$(detect_engine "$gdir")"
  [ -n "$name" ] || name="$(basename "$exe" .exe)"
  name="$(safe_name "$name")"
  say "游戏: $title"
  say "引擎: $(engine_title "$engine")    主程序: $rel"

  local route="wine" dest bottle=""
  if { [ "$engine" = mv ] || [ "$engine" = mz ] || [ "$engine" = tyrano ]; } && [ -f "$gdir/package.json" ]; then
    route="nw"
  fi

  if [ "$route" = nw ]; then
    dest="$GAL_HOME/games/$name"
    mkdir -p "$GAL_HOME/games"
  else
    bottle="$name"
    # Unity 6 靠 EnableMouseInPointer 收鼠标，Wine 11.0 没实现；装了开发版就用开发版
    if [ "$engine" = unity ] && wine_bin_of "Wine Devel" >/dev/null; then
      mkdir -p "$BOTTLES/$bottle"
      echo "Wine Devel" > "$BOTTLES/$bottle/.gal-wine"
      use_wine "Wine Devel"
      say "Unity 游戏，使用 Wine 开发版（$(wine --version)）"
    fi
    need_wine
    cmd_bottle "$bottle"
    isolate_bottle "$BOTTLES/$bottle"
    touch "$BOTTLES/$bottle/.gal-isolated"
    dest="$BOTTLES/$bottle/drive_c/Games/$name"
    mkdir -p "$BOTTLES/$bottle/drive_c/Games"
  fi

  say "拷贝游戏文件（$(du -sh "$gdir" | cut -f1 | tr -d " ")）"
  if [ -n "$IMPORT_STAGE" ]; then
    mv "$gdir" "$dest"
  else
    ditto "$gdir" "$dest"
  fi
  xattr -dr com.apple.quarantine "$dest" 2>/dev/null || true

  if [ "$route" = nw ]; then
    # NW.js 拒绝空的 name 字段
    perl -0pi -e 's/"name"\s*:\s*""/"name": "game"/' "$dest/package.json"
    write_launcher "$name" nw "$dest"
  else
    if [ "$engine" = unity ]; then
      local dx
      dx="$(find_dxvk)"
      if [ -n "$dx" ]; then
        say "Unity 游戏，安装 DXVK"
        cmd_dxvk -b "$bottle" "$dx"
      else
        warn "Unity 游戏通常需要 DXVK，但 $GAL_HOME/downloads 里没有 dxvk-macOS-*.tar.gz"
        warn "下载: https://github.com/Gcenx/DXVK-macOS/releases，放进去后执行: gal dxvk -b $bottle <文件>"
      fi
    fi
    write_launcher "$name" run -b "$bottle" -l "$lang" "$dest/$rel"
  fi

  {
    echo "title=$title"
    echo "engine=$engine"
    echo "route=$route"
    echo "lang=$lang"
    echo "bottle=$bottle"
    echo "dir=$dest"
    echo "exe=$rel"
    echo "source=$src"
    echo "imported=$(date '+%Y-%m-%d %H:%M')"
  } > "$GAL_HOME/launch/$name.meta"

  say "导入完成: $name"
  if [ "$start" = 1 ]; then cmd_start "$name"; fi
}

# 列出导入的游戏：名字<TAB>标题<TAB>引擎
cmd_list() {
  local m n
  for m in "$GAL_HOME"/launch/*.meta; do
    [ -f "$m" ] || continue
    n="$(basename "$m" .meta)"
    printf '%s\t%s\t%s\n' "$n" "$(meta_get "$m" title)" "$(engine_title "$(meta_get "$m" engine)")"
  done
}

meta_get() {
  sed -n "s/^$2=//p" "$1" | head -1
}

# 删除导入的游戏：容器（含游戏副本）、启动器、日志；原始文件不动
cmd_remove() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: gal remove <名字>"
  local m="$GAL_HOME/launch/$name.meta"
  [ -f "$m" ] || die "没有导入过 $name"
  local bottle dir
  bottle="$(meta_get "$m" bottle)"
  dir="$(meta_get "$m" dir)"
  if [ -n "$bottle" ] && [ -d "$BOTTLES/$bottle" ]; then
    ( select_bottle_wine "$bottle"; WINEPREFIX="$BOTTLES/$bottle" wineserver -k 2>/dev/null || true )
    rm -rf "${BOTTLES:?}/$bottle"
  elif [ -n "$dir" ]; then
    case "$dir" in "$GAL_HOME"/games/?*) rm -rf "$dir" ;; esac
  fi
  rm -f "$GAL_HOME/launch/$name.meta" "$GAL_HOME/launch/$name.command" "$GAL_HOME/logs/$name.log"
  say "已删除 $name（原始文件没动）"
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    doctor)       cmd_doctor "$@" ;;
    setup)        cmd_setup "$@" ;;
    detect)       cmd_detect "$@" ;;
    run)          cmd_run "$@" ;;
    nw)           cmd_nw "$@" ;;
    nw-install)   cmd_nw_install "$@" ;;
    bottle)       cmd_bottle "$@" ;;
    cfg)          cmd_cfg "$@" ;;
    kill)         cmd_kill "$@" ;;
    wine)         cmd_wine "$@" ;;
    launcher)     cmd_launcher "$@" ;;
    dxvk)         cmd_dxvk "$@" ;;
    start)        cmd_start "$@" ;;
    import)       cmd_import "$@" ;;
    list)         cmd_list "$@" ;;
    remove)       cmd_remove "$@" ;;
    ""|-h|--help|help) usage ;;
    *)            usage; die "未知命令: $cmd" ;;
  esac
}

main "$@"
