#!/bin/bash
# gal — 在 Apple Silicon Mac 上运行 galgame / 小游戏的辅助脚本
# 兼容 macOS 自带的 bash 3.2
set -euo pipefail

GAL_HOME="${GAL_HOME:-$HOME/Games/gal}"
BOTTLES="$GAL_HOME/bottles"
RUNTIMES="$GAL_HOME/runtimes"
DEFAULT_BOTTLE="${GAL_BOTTLE:-default}"
# 关掉 MoltenVK 每次启动刷屏的设备信息
export MVK_CONFIG_LOG_LEVEL="${MVK_CONFIG_LOG_LEVEL:-0}"

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WINE_URL="https://github.com/Gcenx/macOS_Wine_builds/releases"

# 依次在这些位置找 Wine，找到就放到 PATH 最前面
locate_wine() {
  local d
  for d in \
    "${GAL_WINE_DIR:-}" \
    "$RUNTIMES/Wine Stable.app/Contents/Resources/wine/bin" \
    "/Applications/Wine Stable.app/Contents/Resources/wine/bin"; do
    if [ -n "$d" ] && [ -x "$d/wine" ]; then
      PATH="$d:$PATH"
      export PATH
      return 0
    fi
  done
  return 0
}
locate_wine

need_wine() {
  have wine || die "没有找到 wine，请先运行: gal setup"
}

# 从本地 tar.xz 安装 Wine 到 $RUNTIMES，不需要联网和管理员权限
install_wine_tarball() {
  local tb="$1"
  [ -f "$tb" ] || die "找不到文件: $tb"
  local tmp
  tmp="$(mktemp -d)"
  say "解压 $tb"
  tar -xJf "$tb" -C "$tmp"
  local app
  app="$(find "$tmp" -maxdepth 2 -name 'Wine*.app' -print -quit)"
  [ -n "$app" ] || die "压缩包里没有找到 Wine*.app"
  mkdir -p "$RUNTIMES"
  rm -rf "$RUNTIMES/Wine Stable.app"
  mv "$app" "$RUNTIMES/Wine Stable.app"
  rm -rf "$tmp"
  xattr -dr com.apple.quarantine "$RUNTIMES/Wine Stable.app" 2>/dev/null || true
  locate_wine
  have wine || die "安装后仍然找不到 wine"
  say "Wine 已安装到 $RUNTIMES/Wine Stable.app"
}

has_rosetta() {
  arch -x86_64 /usr/bin/true >/dev/null 2>&1
}

locale_of() {
  case "$1" in
    ja)   echo "ja_JP.UTF-8" ;;
    zh)   echo "zh_CN.UTF-8" ;;
    tw)   echo "zh_TW.UTF-8" ;;
    ko)   echo "ko_KR.UTF-8" ;;
    none) echo "" ;;
    *)    die "未知语言: $1（可选 ja / zh / tw / ko / none）" ;;
  esac
}

usage() {
  cat <<'EOF'
用法: gal <命令> [参数]

  doctor                      检查环境
  setup [--wine-tarball 文件]  安装 Rosetta 2 和 Wine，并创建默认容器（可用本地包离线安装）
  detect <游戏目录>           识别游戏引擎并给出推荐路线
  run [-b 容器] [-l 语言] <exe> [参数...]
                              用 Wine 启动；语言: ja(默认) zh tw ko none
  nw <游戏目录>               用原生 arm64 NW.js 启动 RPG Maker MV/MZ、TyranoScript 游戏
  nw-install                  下载/更新 NW.js（NWJS_VERSION=v0.xx.x 可指定版本）
  bottle <名字>               新建或修复一个 Wine 容器
  cfg [-b 容器]               打开 winecfg
  kill [-b 容器]              结束容器内所有进程
  launcher <名字> [-b 容器] [-l 语言] <exe> [参数...]
                              生成可双击的启动器（~/Games/gal/launch/<名字>.command）
  start <名字>                在桌面会话里运行启动器（从 SSH 远程启动游戏用这个）
  dxvk [-b 容器] <tar.gz>     把 DXVK-macOS 装进容器（Unity 等 D3D11 游戏图形初始化失败时用）

环境变量:
  GAL_HOME    数据目录，默认 ~/Games/gal
  GAL_BOTTLE  默认容器名，默认 default
  NWJS_APP    自定义 nwjs.app 路径
EOF
}

cmd_doctor() {
  [ "$(uname -s)" = "Darwin" ] || die "这个脚本只支持 macOS"

  if [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = "1" ]; then
    say "芯片: Apple Silicon ($(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo unknown))"
  else
    warn "芯片: 不是 Apple Silicon，本方案的原生路线不适用"
  fi
  say "系统: macOS $(sw_vers -productVersion)"
  say "内存: $(( $(sysctl -n hw.memsize) / 1073741824 )) GB"

  if has_rosetta; then say "Rosetta 2: 已安装"; else warn "Rosetta 2: 未安装（gal setup 会安装）"; fi

  local t
  for t in brew wine; do
    if have "$t"; then say "$t: $(command -v "$t")"; else warn "$t: 未安装"; fi
  done
  if have wine; then say "wine 版本: $(wine --version 2>/dev/null || echo 无法获取)"; fi

  if [ -d "/Applications/CrossOver.app" ]; then say "CrossOver: 已安装（3D 游戏优先用它）"; fi

  if pmset -g 2>/dev/null | grep -Eq 'lowpowermode[[:space:]]+1'; then
    warn "低电量模式已开启，性能会被限制"
  else
    say "低电量模式: 关闭"
  fi

  say "可用空间: $(df -h "$HOME" | awk 'NR==2 {print $4}')"
  if [ -d "$BOTTLES" ]; then
    say "容器: $(ls "$BOTTLES" 2>/dev/null | tr '\n' ' ')"
  else
    warn "还没有容器（gal setup 会创建）"
  fi
}

cmd_setup() {
  [ "$(uname -s)" = "Darwin" ] || die "这个脚本只支持 macOS"
  have brew || die "请先安装 Homebrew: https://brew.sh"

  if ! has_rosetta; then
    say "安装 Rosetta 2"
    softwareupdate --install-rosetta --agree-to-license
  fi

  mkdir -p "$BOTTLES" "$RUNTIMES"

  if [ "${1:-}" = "--wine-tarball" ]; then
    [ $# -ge 2 ] || die "--wine-tarball 后面要跟文件路径"
    install_wine_tarball "$2"
  fi

  if ! have wine; then
    say "安装 Wine"
    if ! brew install --cask wine-stable; then
      warn "Homebrew 安装 Wine 失败（多半是连不上 GitHub）"
      warn "请在能访问 GitHub 的机器上从 $WINE_URL 下载 wine-stable-*-osx64.tar.xz，"
      warn "拷到本机后执行: gal setup --wine-tarball <文件路径>"
      exit 1
    fi
    locate_wine
  fi
  if [ -d "/Applications/Wine Stable.app" ]; then
    xattr -dr com.apple.quarantine "/Applications/Wine Stable.app" 2>/dev/null || true
  fi

  if [ ! -d "/Library/Frameworks/GStreamer.framework" ]; then
    warn "没有 GStreamer 运行库，游戏内视频可能无法播放。需要时手动执行（要输入管理员密码）:"
    warn "  brew install --cask gstreamer-runtime"
  fi
  if [ ! -d "$BOTTLES/$DEFAULT_BOTTLE" ]; then
    cmd_bottle "$DEFAULT_BOTTLE"
  fi

  say "完成。试试: gal run /path/to/game.exe"
}

cmd_bottle() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: gal bottle <名字>"
  need_wine

  local p="$BOTTLES/$name"
  mkdir -p "$BOTTLES"
  say "初始化容器: $p"

  export WINEPREFIX="$p"
  export WINEDEBUG=-all
  wineboot -u

  # 导入默认设置：关闭 Retina 模式、字体抗锯齿、
  # 把 Windows 的中日韩字体名映射到 macOS 自带字体（不用下载任何字体）
  local reg_src="$SCRIPT_DIR/../share/gal-defaults.reg"
  [ -f "$reg_src" ] || die "找不到 $reg_src"
  local tmp
  tmp="$(mktemp -d)"
  # regedit 要求 UTF-16LE + BOM + CRLF
  {
    printf '\377\376'
    awk '{ printf "%s\r\n", $0 }' "$reg_src" | iconv -f UTF-8 -t UTF-16LE
  } > "$tmp/gal.reg"
  ( cd "$tmp" && wine regedit /S gal.reg ) || warn "导入默认设置失败"
  rm -rf "$tmp"

  wineserver -w || true
  say "容器 $name 就绪"
}

# 解析 -b / -l 选项；结果写入全局 OPT_BOTTLE、OPT_LANG、OPT_SHIFT
parse_opts() {
  OPT_BOTTLE="$DEFAULT_BOTTLE"
  OPT_LANG="ja"
  OPT_SHIFT=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -b) [ $# -ge 2 ] || die "-b 后面要跟容器名"; OPT_BOTTLE="$2"; shift 2; OPT_SHIFT=$((OPT_SHIFT + 2)) ;;
      -l) [ $# -ge 2 ] || die "-l 后面要跟语言"; OPT_LANG="$2"; shift 2; OPT_SHIFT=$((OPT_SHIFT + 2)) ;;
      --) OPT_SHIFT=$((OPT_SHIFT + 1)); break ;;
      -*) die "未知选项: $1" ;;
      *)  break ;;
    esac
  done
}

cmd_run() {
  parse_opts "$@"
  shift "$OPT_SHIFT"
  [ $# -ge 1 ] || die "用法: gal run [-b 容器] [-l 语言] <exe> [参数...]"

  local exe="$1"
  shift
  [ -f "$exe" ] || die "找不到文件: $exe"
  need_wine

  local loc
  loc="$(locale_of "$OPT_LANG")"

  local p="$BOTTLES/$OPT_BOTTLE"
  if [ ! -d "$p" ]; then
    warn "容器 $OPT_BOTTLE 不存在，先创建"
    cmd_bottle "$OPT_BOTTLE"
  fi

  local dir base
  dir="$(cd "$(dirname "$exe")" && pwd)"
  base="$(basename "$exe")"

  # 很多游戏用相对路径找资源，必须在游戏目录里启动
  cd "$dir"

  export WINEPREFIX="$p"
  export WINEDEBUG="${WINEDEBUG:--all}"
  export WINEMSYNC=1
  export WINEESYNC=1
  if [ -n "$loc" ]; then
    export LC_ALL="$loc"
    export LANG="$loc"
  fi

  say "容器: $OPT_BOTTLE  区域: ${loc:-系统默认}  程序: $base"
  exec wine "$base" "$@"
}

cmd_cfg() {
  parse_opts "$@"
  need_wine
  WINEPREFIX="$BOTTLES/$OPT_BOTTLE" WINEDEBUG=-all exec winecfg
}

# 把 DXVK-macOS 装进容器：D3D10/11 → Vulkan → MoltenVK → Metal
# 用于 Wine 自带 D3D11 初始化失败的 Unity 等游戏
cmd_dxvk() {
  parse_opts "$@"
  shift "$OPT_SHIFT"
  local tb="${1:-}"
  [ -n "$tb" ] && [ -f "$tb" ] || die "用法: gal dxvk [-b 容器] <dxvk-macOS-*.tar.gz>（下载: https://github.com/Gcenx/DXVK-macOS/releases）"
  need_wine

  local p="$BOTTLES/$OPT_BOTTLE"
  [ -d "$p" ] || die "容器 $OPT_BOTTLE 不存在"

  local tmp
  tmp="$(mktemp -d)"
  tar -xzf "$tb" -C "$tmp"
  local x64 x32
  x64="$(find "$tmp" -type d -name x64 -print -quit)"
  x32="$(find "$tmp" -type d -name x32 -print -quit)"
  [ -n "$x64" ] && [ -f "$x64/d3d11.dll" ] || { rm -rf "$tmp"; die "压缩包里没有 x64/d3d11.dll，请用不带 -builtin 的版本"; }

  cp "$x64"/*.dll "$p/drive_c/windows/system32/"
  if [ -n "$x32" ] && [ -d "$p/drive_c/windows/syswow64" ]; then
    cp "$x32"/*.dll "$p/drive_c/windows/syswow64/"
  fi
  rm -rf "$tmp"

  local d
  for d in d3d11 d3d10core; do
    ( cd "$p/drive_c" && WINEPREFIX="$p" WINEDEBUG=-all \
      wine reg add 'HKCU\Software\Wine\DllOverrides' /v "$d" /t REG_SZ /d native /f >/dev/null )
  done
  WINEPREFIX="$p" wineserver -w || true
  say "DXVK 已装进容器 $OPT_BOTTLE（只影响这个容器）"
}

# 生成可双击的启动器 ~/Games/gal/launch/<名字>.command
# 游戏必须在桌面会话里启动；从 SSH 直接 gal run 会报 “no driver could be loaded”
cmd_launcher() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: gal launcher <名字> [-b 容器] [-l 语言] <exe> [参数...]"
  shift
  parse_opts "$@"
  shift "$OPT_SHIFT"
  [ $# -ge 1 ] || die "用法: gal launcher <名字> [-b 容器] [-l 语言] <exe> [参数...]"
  [ -f "$1" ] || die "找不到文件: $1"

  local exe
  exe="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
  shift

  local self
  self="$SCRIPT_DIR/$(basename "$0")"
  mkdir -p "$GAL_HOME/launch" "$GAL_HOME/logs"
  local f="$GAL_HOME/launch/$name.command"
  {
    echo '#!/bin/bash'
    echo "# 由 gal launcher 生成，可双击运行；日志在 $GAL_HOME/logs/$name.log"
    printf 'exec %q run -b %q -l %q %q' "$self" "$OPT_BOTTLE" "$OPT_LANG" "$exe"
    local a
    for a in "$@"; do printf ' %q' "$a"; done
    printf ' > %q 2>&1\n' "$GAL_HOME/logs/$name.log"
  } > "$f"
  chmod +x "$f"
  say "已生成 $f"
  say "双击它启动，或在终端/SSH 里执行: gal start $name"
}

cmd_start() {
  local name="${1:-}"
  [ -n "$name" ] || die "用法: gal start <名字>"
  local f="$GAL_HOME/launch/$name.command"
  [ -x "$f" ] || die "没有启动器 $f，先用 gal launcher 生成"
  open "$f"
  say "已在桌面会话里启动 $name，日志: $GAL_HOME/logs/$name.log"
}

cmd_kill() {
  parse_opts "$@"
  need_wine
  WINEPREFIX="$BOTTLES/$OPT_BOTTLE" wineserver -k || true
  say "已结束容器 $OPT_BOTTLE 里的进程"
}

cmd_nw_install() {
  have curl || die "需要 curl"
  local ver="${NWJS_VERSION:-}"
  if [ -z "$ver" ]; then
    ver="$(curl -fsSL https://nwjs.io/versions.json | grep -m1 '"latest"' | sed -E 's/.*"(v[0-9.]+)".*/\1/')"
  fi
  case "$ver" in
    v[0-9]*) ;;
    *) die "无法确定 NW.js 版本，请用 NWJS_VERSION=v0.xx.x 指定" ;;
  esac

  local url="https://dl.nwjs.io/$ver/nwjs-$ver-osx-arm64.zip"
  local tmp
  tmp="$(mktemp -d)"
  say "下载 NW.js $ver (arm64)"
  curl -fL --progress-bar -o "$tmp/nwjs.zip" "$url" || die "下载失败: $url"
  ditto -x -k "$tmp/nwjs.zip" "$tmp/out"

  local found
  found="$(find "$tmp/out" -maxdepth 2 -name 'nwjs.app' -print -quit)"
  [ -n "$found" ] || die "压缩包里没有找到 nwjs.app"

  mkdir -p "$RUNTIMES"
  rm -rf "$RUNTIMES/nwjs.app"
  mv "$found" "$RUNTIMES/nwjs.app"
  rm -rf "$tmp"
  xattr -dr com.apple.quarantine "$RUNTIMES/nwjs.app" 2>/dev/null || true
  say "NW.js 已安装到 $RUNTIMES/nwjs.app"
}

cmd_nw() {
  local d="${1:-}"
  [ -n "$d" ] && [ -d "$d" ] || die "用法: gal nw <游戏目录>"
  d="$(cd "$d" && pwd)"

  [ -f "$d/package.json" ] || die "$d 里没有 package.json，这不是 NW.js 游戏，或者需要先补一个（见 docs/engines.md）"

  if grep -Eq '"name"[[:space:]]*:[[:space:]]*""' "$d/package.json"; then
    die "package.json 里的 \"name\" 是空的，NW.js 会拒绝启动。请把它改成任意非空值，例如 \"name\": \"game\""
  fi

  local app="${NWJS_APP:-$RUNTIMES/nwjs.app}"
  if [ ! -d "$app" ]; then
    cmd_nw_install
  fi

  say "用原生 NW.js 启动: $d"
  exec "$app/Contents/MacOS/nwjs" "$d"
}

cmd_detect() {
  local d="${1:-.}"
  [ -d "$d" ] || die "用法: gal detect <游戏目录>"

  # 目录内（最多 3 层）是否存在匹配名字的文件或目录
  has() {
    find "$d" -maxdepth 3 -iname "$1" -print -quit 2>/dev/null | grep -q .
  }
  report() {
    say "引擎: $1"
    say "路线: $2"
    if [ -n "${3:-}" ]; then say "做法: $3"; fi
  }

  if has '*.rpa' || has '*.rpyc' || has 'renpy'; then
    if has '*.app'; then
      report "Ren'Py" "原生" "直接打开目录里的 .app"
    else
      report "Ren'Py" "原生" "用对应大版本的 Ren'Py SDK 启动（见 docs/engines.md）"
    fi
  elif has '*.app'; then
    report "自带 macOS 版" "原生" "直接打开 .app；用 file 命令确认里面是 arm64 还是 x86_64"
  elif has 'rmmz_core.js'; then
    report "RPG Maker MZ" "原生 NW.js" "gal nw \"$d\""
  elif has 'rpg_core.js'; then
    report "RPG Maker MV" "原生 NW.js" "gal nw \"$d\""
  elif has '*.rgss3a'; then
    report "RPG Maker VX Ace (RGSS3)" "原生 mkxp-z，或 Wine" "见 docs/engines.md"
  elif has '*.rgss2a'; then
    report "RPG Maker VX (RGSS2)" "原生 mkxp-z，或 Wine" "见 docs/engines.md"
  elif has '*.rgssad'; then
    report "RPG Maker XP (RGSS1)" "原生 mkxp-z，或 Wine" "见 docs/engines.md"
  elif has 'tyrano'; then
    report "TyranoScript" "原生 NW.js" "gal nw <含 package.json 的目录>"
  elif has 'nscript.dat' || has 'arc.nsa' || has 'nscript.___'; then
    report "NScripter" "原生 ONScripter，或 Wine" "见 docs/engines.md"
  elif has '*.xp3'; then
    report "吉里吉里 (Kirikiri)" "Wine，日文区域" "gal run <游戏exe>"
  elif has 'Scene.pck' || has 'Gameexe.dat' || has 'SiglusEngine*.exe'; then
    report "SiglusEngine" "Wine，日文区域" "gal run <游戏exe>"
  elif has 'Seen.txt' || has 'RealLive.exe'; then
    report "RealLive" "Wine，日文区域" "gal run <游戏exe>"
  elif has 'UnityPlayer.dll' || has 'globalgamemanagers' || has '*_Data'; then
    report "Unity" "Wine；3D 游戏用 CrossOver 或 Sikarugir 的 D3DMetal" "gal run <游戏exe>"
  elif has 'cs2.exe' || has '*.int'; then
    report "CatSystem2" "Wine，日文区域" "gal run <游戏exe>"
  elif has 'BGI.exe' || has 'BHVC.exe'; then
    report "BGI / Ethornell" "Wine，日文区域" "gal run <游戏exe>"
  elif has '*.wolf'; then
    report "Wolf RPG Editor" "Wine，日文区域" "gal run Game.exe"
  elif has 'nw.dll' || has 'package.nw' || has 'package.json'; then
    report "NW.js / Electron 类网页游戏" "优先原生 NW.js" "gal nw <含 package.json 的目录>；不行再 gal run"
  elif has '*.exe'; then
    report "未识别的 Windows 游戏" "Wine" "gal run <游戏exe>；日文游戏保持默认区域，其他加 -l none"
  else
    warn "没有识别出引擎，目录里也没有 exe"
    return 1
  fi
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    doctor)       cmd_doctor "$@" ;;
    setup)        cmd_setup "$@" ;;
    detect)       cmd_detect "$@" ;;
    run)          cmd_run "$@" ;;
    nw)           cmd_nw "$@" ;;
    nw-install)   cmd_nw_install "$@" ;;
    bottle)       cmd_bottle "$@" ;;
    cfg)          cmd_cfg "$@" ;;
    kill)         cmd_kill "$@" ;;
    launcher)     cmd_launcher "$@" ;;
    dxvk)         cmd_dxvk "$@" ;;
    start)        cmd_start "$@" ;;
    ""|-h|--help|help) usage ;;
    *)            usage; die "未知命令: $cmd" ;;
  esac
}

main "$@"
